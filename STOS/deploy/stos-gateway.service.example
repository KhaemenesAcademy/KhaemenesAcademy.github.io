[Unit]
Description=Sovereign Terminal OS Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stos
Group=stos
WorkingDirectory=/opt/stos-gateway
EnvironmentFile=/opt/stos-gateway/.env
ExecStart=/usr/bin/node /opt/stos-gateway/src/server.mjs
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
